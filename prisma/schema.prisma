generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String?
  name      String?
  avatar    String?
  googleId  String?
  provider  String   @default("local")
  createdAt DateTime @default(now())

  @@index([googleId])
}