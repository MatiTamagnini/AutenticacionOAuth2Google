# Google OAuth2 (Google Cloud Console > Credenciales > ID de cliente de OAuth)
GOOGLE_CLIENT_ID=tu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# JWT (generar una clave larga y aleatoria)
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=clave_larga_y_aleatoria
JWT_EXPIRES_IN=1h

# Servidor
PORT=3000

# SQL Server (autenticacion de Windows)
# El puerto puede variar: ver SQL Server Configuration Manager >
# Protocols for SQLEXPRESS > TCP/IP > IP Addresses > IPAll > TCP Dynamic Ports
DATABASE_URL="sqlserver://localhost:PUERTO;database=tp_oauth_google;integratedSecurity=true;trustServerCertificate=true"